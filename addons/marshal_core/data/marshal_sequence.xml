<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_marshal_movement" model="ir.sequence">
            <field name="name">Marshal Movement</field>
            <field name="code">marshal.movement</field>
            <field name="prefix">MV</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <!-- Claim sequence is comparator rule 7, the final tie-break. It must
             be monotonic and never reused, so no prefix and no per-company
             split. -->
        <record id="seq_marshal_claim" model="ir.sequence">
            <field name="name">Marshal Claim Sequence</field>
            <field name="code">marshal.claim.seq</field>
            <field name="padding">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
